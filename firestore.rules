rules_version = '2';

// GateWatch Firestore rules
//
// Everyone who signs up gets their OWN private workspace: workspaces/<their user id>.
// Only that person can read or change anything inside it. Nobody can see anybody
// else's workspace, and there is nothing to approve.
//
// The Python sensor uses the Admin SDK, which bypasses these rules, so it can
// write alerts, traffic, devices, stats and heartbeats into a workspace. These
// rules only control what people can do from the browser.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers
    function isOwner(wid) {
      return request.auth != null && request.auth.uid == wid;
    }

    // on an update, true if ONLY these fields were touched
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // on an update, true if this field was touched
    function changed(key) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([key]);
    }

    match /workspaces/{wid} {

      // ---------------------------------------------------------- alerts
      // Alerts are your audit trail: created only by the sensor, never deleted.
      // You can move the status along and cache an AI summary, nothing else.
      match /alerts/{alertId} {
        allow read: if isOwner(wid);
        allow create, delete: if false;

        allow update: if isOwner(wid)
          && onlyChanges(['status', 'acknowledgedBy', 'acknowledgedAt',
                          'resolvedBy', 'resolvedAt', 'aiSummary'])
          && request.resource.data.status in
               ['new', 'acknowledged', 'investigating', 'resolved', 'false_positive']
          && (!changed('acknowledgedBy') || request.resource.data.acknowledgedBy == request.auth.uid)
          && (!changed('acknowledgedAt') || request.resource.data.acknowledgedAt == request.time)
          && (!changed('resolvedBy') || request.resource.data.resolvedBy == request.auth.uid)
          && (!changed('resolvedAt') || request.resource.data.resolvedAt == request.time)
          && (!changed('aiSummary') || request.resource.data.aiSummary.mode in ['on_device', 'cloud']);

        // notes: add-only, written as yourself, can't be edited or removed
        match /notes/{noteId} {
          allow read: if isOwner(wid);
          allow create: if isOwner(wid)
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000;
          allow update, delete: if false;
        }

        // timeline: you can add entries (like "Acknowledged"), nobody edits them
        match /timeline/{entryId} {
          allow read: if isOwner(wid);
          allow create: if isOwner(wid)
            && request.resource.data.at == request.time
            && request.resource.data.title is string
            && request.resource.data.title.size() <= 200;
          allow update, delete: if false;
        }
      }

      // --------------------------------------------------------- traffic
      // Read-only in the browser. The sensor writes it, TTL deletes it.
      match /traffic/{id} {
        allow read: if isOwner(wid);
        allow write: if false;
      }

      // --------------------------------------------------------- devices
      // You can rename a device or mark it as known. The sensor does the rest.
      match /devices/{deviceId} {
        allow read: if isOwner(wid);
        allow create: if false;
        allow update: if isOwner(wid) && onlyChanges(['name', 'known']);
        allow delete: if isOwner(wid);
      }

      // ------------------------------------------------------- watchlist
      // You can add an IP, block/unblock it, or edit the reason.
      match /watchlist/{ipDocId} {
        allow read: if isOwner(wid);

        allow create: if isOwner(wid)
          && request.resource.data.keys().hasOnly(
               ['ip', 'addedAt', 'reason', 'reputationScore', 'country',
                'hits', 'lastSeen', 'blocked', 'addedBy'])
          && request.resource.data.ip is string
          && request.resource.data.blocked is bool
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.addedAt == request.time;

        allow update: if isOwner(wid) && onlyChanges(['blocked', 'reason']);
        allow delete: if isOwner(wid);
      }

      // --------------------------------------------------------- sensors
      match /sensors/{sensorId} {
        allow read: if isOwner(wid);
        allow write: if false;
      }

      // ------------------------------------------------------- audit log
      // You add entries as yourself. Nobody can edit or delete an entry.
      match /auditLog/{id} {
        allow read: if isOwner(wid);
        allow create: if isOwner(wid)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.timestamp == request.time
          && request.resource.data.action is string;
        allow update, delete: if false;
      }

      // ----------------------------------------------------------- stats
      match /stats/{day} {
        allow read: if isOwner(wid);
        allow write: if false;
      }
    }

    // ----------------------------------------------- everything else: no
    match /{document=**} {
      allow read, write: if false;
    }
  }
}